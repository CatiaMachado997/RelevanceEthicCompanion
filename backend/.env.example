# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ethic-companion
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Weaviate Configuration
WEAVIATE_URL=http://localhost:8080

# Groq API
GROQ_API_KEY=gsk_your_key_here
GROQ_EVAL_MODEL=openai/gpt-oss-20b
GROQ_EVAL_MAX_TOKENS=4096
DEEPEVAL_RETRY_MAX_ATTEMPTS=4
DEEPEVAL_RETRY_INITIAL_SECONDS=16
DEEPEVAL_RETRY_CAP_SECONDS=30

# Gemini API
GEMINI_API_KEY=your_key_here
OPENAI_API_KEY=
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
RAG_HYBRID_ALPHA=0.5
RAG_DEFAULT_K=5
RAG_CANDIDATE_FLOOR=20
RAG_RERANK_PROVIDER=local
RAG_RRF_K=60
# Keep the cleaned-query ordering; original-query-only candidates remain as
# fallback recall candidates for reranking.
RAG_ORIGINAL_QUERY_WEIGHT=0.0
RAG_QUERY_EXPANSION=0
RAG_QUERY_EXPANSION_WEIGHT=0.8
RAG_METADATA_RERANK_WEIGHT=0
RAG_MAX_CHUNKS_PER_DOCUMENT=2
RAG_NEAR_DUPLICATE_THRESHOLD=0.88
RAG_NEIGHBOR_WINDOW=1
# Deterministic per-user treatment rollout. Keep at 0 until eval gates pass.
RAG_ROLLOUT_PERCENT=0
RAG_ROLLOUT_ALPHA=0.5
RAG_ROLLOUT_TOP_K=4
RAG_ROLLOUT_QUERY_EXPANSION=0

# Tavily Search API
TAVILY_API_KEY=your_key_here

# Google Cloud
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_APPLICATION_CREDENTIALS=

# Google OAuth (Calendar + Gmail)
GOOGLE_OAUTH_CLIENT_ID=your_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/data-sources/oauth/google-calendar/callback

# Application Settings
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Security
SECRET_KEY=generate_a_random_32_byte_hex_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Supabase Auth (required for JWT enforcement)
AUTH_ENFORCEMENT_ENABLED=False
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Slack OAuth
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:8000/api/data-sources/oauth/slack/callback

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Langfuse Observability (Sprint 2a)
LANGFUSE_PUBLIC_KEY=         # Required for observability (get from langfuse.com)
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Composio Tool Integration Platform
# Free tier: 20K tool calls/month. Get key: https://app.composio.dev/settings
COMPOSIO_API_KEY=your_composio_api_key_here

# Jina Reranker (Sprint G Task 3) — optional cross-encoder rerank pass over
# hybrid-search results. Free tier: 100 RPM. Without a key the system falls
# back to raw hybrid top-K (no rerank). Get key: https://jina.ai/reranker
JINA_API_KEY=
RERANK_MODEL=jina-reranker-v2-base-multilingual

# ── Agent execution modes ────────────────────────────────────────────────
# These flags are NOT all independent. There are two execution architectures:
#
#   * Single-agent ReAct path (default) — the tool_planner/tool_execution
#     loop. PLANNER_PARALLEL_ENABLED, STREAMING_REASONING_ENABLED, and
#     EPISODIC_MEMORY_ENABLED all only do anything in THIS mode.
#   * Multi-agent supervisor path (MULTI_AGENT=true) — a supervisor that
#     delegates to specialist worker agents. This is a different graph; the
#     three flags above are no-ops under it.
#
# MULTI_AGENT and STREAMING_REASONING_ENABLED are mutually exclusive: the
# streaming path has no multi-agent variant, so if both are set, streaming
# wins and MULTI_AGENT is ignored (a warning is logged).

# Multi-agent supervisor architecture (from the LangGraph multi-agent work).
# Read via os.getenv, not config. Default off — the single-agent ReAct path
# is the primary, most-instrumented mode.
MULTI_AGENT=false

# Sprint I — explicit ReAct + parallel tool actions. When on, independent
# read-only tools in one planner step run concurrently via asyncio.gather;
# when off (default) they run one at a time. Single-agent path only.
PLANNER_PARALLEL_ENABLED=false

# Sprint J — streaming reasoning + interrupts. Streams the planner's thought
# tokens and, in safe mode, pauses per action for user confirmation.
# REQUIRES a working Postgres checkpointer in production (falls back to an
# in-memory saver if unavailable, which loses durable pause/resume across
# restarts). Single-agent path only. Default off; flip on once smoke-tested.
STREAMING_REASONING_ENABLED=false

# Sprint K — episodic tool memory. Default off; flip on once smoke-tested
# in staging. The three tuning knobs are env-configurable so we can adjust
# without redeploying code.
EPISODIC_MEMORY_ENABLED=false
EPISODIC_MEMORY_TOP_K=3
EPISODIC_MEMORY_MIN_SIMILARITY=0.6
EPISODIC_MEMORY_MAX_AGE_DAYS=90
# Optional tracing and hosted comparisons. Local result files are always kept;
# hosted writes occur only when their explicit flags and API keys are present.
DEEPEVAL_TRACING_ENABLED=0
DEEPEVAL_HOSTED=0
CONFIDENT_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ethic-companion-rag
LANGSMITH_API_KEY=
GROQ_EVAL_MODEL=openai/gpt-oss-20b
